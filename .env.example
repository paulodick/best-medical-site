# URL pública do site (canonical, sitemap, Open Graph). Ex.: https://www.bestmedical.com.br
NEXT_PUBLIC_SITE_URL=
# Google Tag Manager (vazio = não carrega). Só carrega após consentimento.
NEXT_PUBLIC_GTM_ID=
# Endpoint que recebe o POST JSON do formulário de chamado (vazio = cai no WhatsApp)
NEXT_PUBLIC_FORM_ENDPOINT=
# Publicação em subcaminho (GitHub Pages: /nome-do-repositorio). Vazio no domínio final.
NEXT_PUBLIC_BASE_PATH=
# 1 = prévia fora dos buscadores (noindex + robots bloqueando tudo)
NEXT_PUBLIC_PREVIEW=
